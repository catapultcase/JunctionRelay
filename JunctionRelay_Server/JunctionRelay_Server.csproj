<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a19cb7a2-588a-4eda-9675-028393e94ec7</UserSecretsId>
    <Version>0.8.8.3</Version>
    <!-- Hide console window in Release builds -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Ical.Net" Version="5.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.16" />
    <PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    <PackageReference Include="MQTTnet" Version="3.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PuppeteerSharp" Version="20.2.2" />
    <PackageReference Include="RJCP.SerialPortStream" Version="3.0.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.12.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.3" />
    <PackageReference Include="System.Management" Version="9.0.3" />
    <PackageReference Include="Tmds.MDns" Version="0.8.0" />
  </ItemGroup>
  <!-- Remove junk from internal build if needed -->
  <ItemGroup>
    <Compile Remove="Handlers\**" />
    <Compile Remove="junctionrelaywebui\node_modules\**" />
    <Compile Remove="Repositories\**" />
    <Content Remove="Handlers\**" />
    <Content Remove="junctionrelaywebui\node_modules\**" />
    <Content Remove="Repositories\**" />
    <EmbeddedResource Remove="Handlers\**" />
    <EmbeddedResource Remove="junctionrelaywebui\node_modules\**" />
    <EmbeddedResource Remove="Repositories\**" />
    <None Remove="Handlers\**" />
    <None Remove="junctionrelaywebui\node_modules\**" />
    <None Remove="Repositories\**" />
  </ItemGroup>
  <!-- Include frontend files in Solution Explorer (but not in build) -->
  <ItemGroup>
    <None Include="junctionrelaywebui\**\*" Exclude="junctionrelaywebui\node_modules\**" />
  </ItemGroup>

  <!-- Exclude junctionrelaywebui folder from publish output -->
  <ItemGroup>
    <Content Remove="junctionrelaywebui\**" />
    <None Remove="junctionrelaywebui\**" />
  </ItemGroup>
  <Target Name="ExcludeFrontendFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').StartsWith('junctionrelaywebui'))" />
    </ItemGroup>
  </Target>

<ItemGroup>
  <!-- FrameEngine template-packages directory (ZIP files only) -->
  <None Update="frameengine\template-packages\**\*.zip">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    <PreserveNewest>true</PreserveNewest>
  </None>
  <!-- CDP screencast capture Node.js script and dependencies -->
  <None Update="Services\cdp_screencast_capture.js">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    <CopyToPublishDirectory>Always</CopyToPublishDirectory>
  </None>
  <None Update="Services\package.json">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    <CopyToPublishDirectory>Always</CopyToPublishDirectory>
  </None>
</ItemGroup>

  <!-- Install CDP capture dependencies after build -->
  <Target Name="InstallCdpCaptureDependencies" AfterTargets="Build">
    <Message Importance="high" Text="📦 Installing CDP capture Node.js dependencies..." Condition="Exists('$(OutputPath)Services\package.json')" />
    <Exec Command="npm install --production" WorkingDirectory="$(OutputPath)Services" Condition="Exists('$(OutputPath)Services\package.json')" />
  </Target>

  <!-- Install CDP capture dependencies during publish (runs after files are copied) -->
  <Target Name="InstallCdpCaptureDependenciesForPublish" AfterTargets="CopyFilesToPublishDirectory">
    <PropertyGroup>
      <PublishServicesDir>$(PublishDir)Services</PublishServicesDir>
    </PropertyGroup>
    <Message Importance="high" Text="📦 Installing CDP capture Node.js dependencies in publish directory: $(PublishServicesDir)" />
    <Exec Command="npm install --omit=dev" WorkingDirectory="$(PublishServicesDir)" Condition="Exists('$(PublishServicesDir)\package.json')" />
  </Target>

  <!-- Build frontend and copy directly into publish/wwwroot -->
  <Target Name="BuildFrontend" BeforeTargets="Publish">
    <Message Importance="high" Text="🔧 Running frontend build and copying to publish wwwroot..." />
    <Exec Command="npm install" WorkingDirectory="junctionrelaywebui" />
    <Exec Command="npm run build" WorkingDirectory="junctionrelaywebui" />
    <PropertyGroup>
      <PublishWwwRoot>$(PublishDir)wwwroot\</PublishWwwRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(PublishWwwRoot)" />
    <MakeDir Directories="$(PublishWwwRoot)" />
    <ItemGroup>
      <FrontendFiles Include="junctionrelaywebui\build\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFiles="@(FrontendFiles->'$(PublishWwwRoot)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>