{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JunctionRelayCloud": {
    "ApiUrl": "https://api.junctionrelay.com"
  },
  "CollectorPlugins": {
    "Enabled": true,
    "DefaultTimeoutMs": 30000,
    "MaxRestarts": 3,
    "RestartDelayMs": 1000
  },
  "ElementPlugins": {
    "Enabled": true
  },
  "PayloadPlugins": {
    "Enabled": true
  },
  "ShaderPlugins": {
    "Enabled": true
  }
}